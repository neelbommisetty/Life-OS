# Shared server-only (root .env)
DATABASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
# Neon Auth upstream URL (e.g. https://<project>.neonauth.../auth)
NEON_AUTH_BASE_URL=

# Web (apps/web)
# Hono API base URL used by web auth proxy (defaults to http://localhost:3001 in development)
API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
# Optional: only if client-side Neon Auth needs a public base URL
NEXT_PUBLIC_NEON_AUTH_BASE_URL=

# API (apps/api)
PORT=3001

# Deployment-only (do not set locally)
# VERCEL_OIDC_TOKEN=
