# Shared server-only (root .env)
DATABASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
# Neon Auth upstream URL (e.g. https://<project>.neonauth.../auth)
NEON_AUTH_BASE_URL=

# Web (apps/web)
# API base URL used by web for all server-side API calls
API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=

# API (apps/api)
PORT=3001
# Optional strict JWT checks for bearer token verification in API
NEON_AUTH_JWT_ISSUER=
NEON_AUTH_JWT_AUDIENCE=

# Deployment-only (do not set locally)
# VERCEL_OIDC_TOKEN=
