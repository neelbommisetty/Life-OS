#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

cd "$REPO_ROOT"

if ! command -v bun >/dev/null 2>&1; then
  echo "bun is required for pre-commit checks." >&2
  exit 1
fi

declare -a staged_files=()
while IFS= read -r path; do
  if [ -n "$path" ]; then
    staged_files+=("$path")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "${#staged_files[@]}" -eq 0 ]; then
  exit 0
fi

declare -a web_lint_files=()
declare -a web_unit_test_files=()
declare -a api_unit_test_files=()
declare -a ai_unit_test_files=()
declare -a db_unit_test_files=()
declare -a logger_unit_test_files=()

run_api_lint=0
run_ai_lint=0
run_db_lint=0
run_logger_lint=0
run_ios_tests=0
run_e2e=1

is_unit_test_file() {
  local file="$1"

  case "$file" in
    *.test.ts|*.test.tsx|*.test.js|*.test.jsx|*.spec.ts|*.spec.tsx|*.spec.js|*.spec.jsx)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

find_ios_simulator_id() {
  local destination_output=""
  local destination_id=""
  local booted_id=""
  local available_id=""

  destination_output=$(
    xcodebuild \
      -project "apps/ios/Life-OS/Life-OS.xcodeproj" \
      -scheme "Life-OS" \
      -showdestinations 2>/dev/null || true
  )
  destination_id=$(
    printf "%s\n" "$destination_output" | awk '
      /platform:iOS Simulator/ && /name:iPhone/ && /id:/ && $0 !~ /placeholder/ {
        if (match($0, /id:[[:space:]]*[0-9A-Fa-f-]+/)) {
          simulator_id = substr($0, RSTART, RLENGTH)
          sub(/^id:[[:space:]]*/, "", simulator_id)
          print simulator_id
          exit 0
        }
      }
    '
  )
  if [ -n "$destination_id" ]; then
    printf "%s" "$destination_id"
    return 0
  fi

  booted_id=$(
    xcrun simctl list devices booted available 2>/dev/null | awk '
      /^[[:space:]]+iPhone/ && /\(Booted\)/ {
        if (match($0, /\([0-9A-Fa-f-]+\)/)) {
          simulator_id = substr($0, RSTART, RLENGTH)
          gsub(/[()]/, "", simulator_id)
          print simulator_id
          exit 0
        }
      }
    '
  )
  if [ -n "$booted_id" ]; then
    printf "%s" "$booted_id"
    return 0
  fi

  available_id=$(
    xcrun simctl list devices available 2>/dev/null | awk '
      /^[[:space:]]+iPhone/ {
        if (match($0, /\([0-9A-Fa-f-]+\)/)) {
          simulator_id = substr($0, RSTART, RLENGTH)
          gsub(/[()]/, "", simulator_id)
          print simulator_id
          exit 0
        }
      }
    '
  )
  if [ -n "$available_id" ]; then
    printf "%s" "$available_id"
    return 0
  fi

  return 1
}

for path in "${staged_files[@]}"; do
  case "$path" in
    apps/web/*)
      rel="${path#apps/web/}"

      case "$rel" in
        *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs)
          web_lint_files+=("$rel")
          ;;
      esac

      if is_unit_test_file "$rel"; then
        case "$rel" in
          tests/e2e/*|*.e2e.*)
            ;;
          *)
            web_unit_test_files+=("$rel")
            ;;
        esac
      fi

      ;;
    apps/api/*)
      rel="${path#apps/api/}"
      run_api_lint=1

      if is_unit_test_file "$rel"; then
        api_unit_test_files+=("$rel")
      fi
      ;;
    packages/ai/*)
      rel="${path#packages/ai/}"
      run_ai_lint=1

      if is_unit_test_file "$rel"; then
        ai_unit_test_files+=("$rel")
      fi
      ;;
    packages/db/*)
      rel="${path#packages/db/}"
      run_db_lint=1

      if is_unit_test_file "$rel"; then
        db_unit_test_files+=("$rel")
      fi
      ;;
    packages/logger/*)
      rel="${path#packages/logger/}"
      run_logger_lint=1

      if is_unit_test_file "$rel"; then
        logger_unit_test_files+=("$rel")
      fi
      ;;
    apps/ios/*)
      run_ios_tests=1
      ;;
  esac
done

if [ "${#web_lint_files[@]}" -gt 0 ]; then
  echo "pre-commit: linting changed files in apps/web"
  (
    cd apps/web
    bun run lint -- "${web_lint_files[@]}"
  )
fi

if [ "$run_api_lint" -eq 1 ]; then
  echo "pre-commit: linting changed files in apps/api workspace"
  bun run --filter=./apps/api lint
fi

if [ "$run_ai_lint" -eq 1 ]; then
  echo "pre-commit: linting changed files in packages/ai workspace"
  bun run --filter=./packages/ai lint
fi

if [ "$run_db_lint" -eq 1 ]; then
  echo "pre-commit: linting changed files in packages/db workspace"
  bun run --filter=./packages/db lint
fi

if [ "$run_logger_lint" -eq 1 ]; then
  echo "pre-commit: linting changed files in packages/logger workspace"
  bun run --filter=./packages/logger lint
fi

if [ "${#web_unit_test_files[@]}" -gt 0 ]; then
  echo "pre-commit: running changed unit tests in apps/web"
  (
    cd apps/web
    bun test "${web_unit_test_files[@]}"
  )
fi

if [ "${#api_unit_test_files[@]}" -gt 0 ]; then
  echo "pre-commit: running changed unit tests in apps/api"
  (
    cd apps/api
    bun test "${api_unit_test_files[@]}"
  )
fi

if [ "${#ai_unit_test_files[@]}" -gt 0 ]; then
  echo "pre-commit: running changed unit tests in packages/ai"
  (
    cd packages/ai
    bun test "${ai_unit_test_files[@]}"
  )
fi

if [ "${#db_unit_test_files[@]}" -gt 0 ]; then
  echo "pre-commit: running changed unit tests in packages/db"
  (
    cd packages/db
    bun test "${db_unit_test_files[@]}"
  )
fi

if [ "${#logger_unit_test_files[@]}" -gt 0 ]; then
  echo "pre-commit: running changed unit tests in packages/logger"
  (
    cd packages/logger
    bun test "${logger_unit_test_files[@]}"
  )
fi

if [ "$run_ios_tests" -eq 1 ]; then
  if ! command -v xcodebuild >/dev/null 2>&1 || ! command -v xcrun >/dev/null 2>&1; then
    echo "pre-commit: iOS changes detected, but Xcode command-line tools are unavailable." >&2
    exit 1
  fi

  ios_simulator_id=$(find_ios_simulator_id || true)
  if [ -z "$ios_simulator_id" ]; then
    echo "pre-commit: iOS changes detected, but no available iPhone simulator was found." >&2
    exit 1
  fi

  echo "pre-commit: running iOS unit tests (Life-OSTests)"
  xcodebuild \
    -project "apps/ios/Life-OS/Life-OS.xcodeproj" \
    -scheme "Life-OS" \
    -destination "platform=iOS Simulator,id=$ios_simulator_id" \
    -parallel-testing-enabled NO \
    -maximum-concurrent-test-simulator-destinations 1 \
    -only-testing:"Life-OSTests" \
    test

  echo "pre-commit: running iOS UI tests (Life-OSUITests)"
  xcodebuild \
    -project "apps/ios/Life-OS/Life-OS.xcodeproj" \
    -scheme "Life-OS" \
    -destination "platform=iOS Simulator,id=$ios_simulator_id" \
    -parallel-testing-enabled NO \
    -maximum-concurrent-test-simulator-destinations 1 \
    -only-testing:"Life-OSUITests" \
    test
fi

if [ "$run_e2e" -eq 1 ]; then
  echo "pre-commit: building packages/db for runtime exports"
  bun run --filter=./packages/db build

  echo "pre-commit: building packages/ai for runtime exports"
  bun run --filter=./packages/ai build

  echo "pre-commit: running web e2e tests"
  DATABASE_URL="${DATABASE_URL:-postgresql://user:pass@localhost:5432/db}" \
  API_BASE_URL="${API_BASE_URL:-http://127.0.0.1:3001}" \
  NEXT_PUBLIC_API_BASE_URL="${NEXT_PUBLIC_API_BASE_URL:-http://127.0.0.1:3001}" \
  bun run test:web:e2e
fi
