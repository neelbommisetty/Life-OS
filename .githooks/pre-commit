#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

cd "$REPO_ROOT"

if ! command -v bun >/dev/null 2>&1; then
  echo "bun is required for pre-commit checks." >&2
  exit 1
fi

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
if [ -z "$current_branch" ] || [ "$current_branch" = "HEAD" ]; then
  current_branch="detached"
fi

declare -a staged_files=()
while IFS= read -r path; do
  if [ -n "$path" ]; then
    staged_files+=("$path")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "${#staged_files[@]}" -eq 0 ]; then
  exit 0
fi

declare -a web_lint_files=()
changed_web=0
changed_api=0
changed_ai=0
changed_db=0
changed_logger=0
changed_ios=0

find_ios_simulator_id() {
  local destination_output=""
  local destination_id=""
  local booted_id=""
  local available_id=""

  destination_output=$(
    xcodebuild \
      -project "apps/ios/Life-OS/Life-OS.xcodeproj" \
      -scheme "Life-OS" \
      -showdestinations 2>/dev/null || true
  )
  destination_id=$(
    printf "%s\n" "$destination_output" | awk '
      /platform:iOS Simulator/ && /name:iPhone/ && /id:/ && $0 !~ /placeholder/ {
        if (match($0, /id:[[:space:]]*[0-9A-Fa-f-]+/)) {
          simulator_id = substr($0, RSTART, RLENGTH)
          sub(/^id:[[:space:]]*/, "", simulator_id)
          print simulator_id
          exit 0
        }
      }
    '
  )
  if [ -n "$destination_id" ]; then
    printf "%s" "$destination_id"
    return 0
  fi

  booted_id=$(
    xcrun simctl list devices booted available 2>/dev/null | awk '
      /^[[:space:]]+iPhone/ && /\(Booted\)/ {
        if (match($0, /\([0-9A-Fa-f-]+\)/)) {
          simulator_id = substr($0, RSTART, RLENGTH)
          gsub(/[()]/, "", simulator_id)
          print simulator_id
          exit 0
        }
      }
    '
  )
  if [ -n "$booted_id" ]; then
    printf "%s" "$booted_id"
    return 0
  fi

  available_id=$(
    xcrun simctl list devices available 2>/dev/null | awk '
      /^[[:space:]]+iPhone/ {
        if (match($0, /\([0-9A-Fa-f-]+\)/)) {
          simulator_id = substr($0, RSTART, RLENGTH)
          gsub(/[()]/, "", simulator_id)
          print simulator_id
          exit 0
        }
      }
    '
  )
  if [ -n "$available_id" ]; then
    printf "%s" "$available_id"
    return 0
  fi

  return 1
}

run_ios_tests() {
  local include_ui="$1"
  local strict="$2"
  local ios_simulator_id=""

  if ! command -v xcodebuild >/dev/null 2>&1 || ! command -v xcrun >/dev/null 2>&1; then
    if [ "$strict" -eq 1 ]; then
      echo "pre-commit: iOS tests required, but Xcode command-line tools are unavailable." >&2
      exit 1
    fi
    echo "pre-commit: skipping iOS tests because Xcode command-line tools are unavailable."
    return 0
  fi

  ios_simulator_id=$(find_ios_simulator_id || true)
  if [ -z "$ios_simulator_id" ]; then
    if [ "$strict" -eq 1 ]; then
      echo "pre-commit: iOS tests required, but no available iPhone simulator was found." >&2
      exit 1
    fi
    echo "pre-commit: skipping iOS tests because no iPhone simulator is available."
    return 0
  fi

  echo "pre-commit: running iOS unit tests (Life-OSTests)"
  xcodebuild \
    -project "apps/ios/Life-OS/Life-OS.xcodeproj" \
    -scheme "Life-OS" \
    -destination "platform=iOS Simulator,id=$ios_simulator_id" \
    -parallel-testing-enabled NO \
    -maximum-concurrent-test-simulator-destinations 1 \
    -only-testing:"Life-OSTests" \
    test

  if [ "$include_ui" -eq 1 ]; then
    echo "pre-commit: running iOS UI tests (Life-OSUITests)"
    xcodebuild \
      -project "apps/ios/Life-OS/Life-OS.xcodeproj" \
      -scheme "Life-OS" \
      -destination "platform=iOS Simulator,id=$ios_simulator_id" \
      -parallel-testing-enabled NO \
      -maximum-concurrent-test-simulator-destinations 1 \
      -only-testing:"Life-OSUITests" \
      test
  fi
}

run_web_e2e_tests() {
  echo "pre-commit: building packages/db for runtime exports"
  bun run --filter=./packages/db build

  echo "pre-commit: building packages/ai for runtime exports"
  bun run --filter=./packages/ai build

  echo "pre-commit: running web e2e tests"
  DATABASE_URL="${DATABASE_URL:-postgresql://user:pass@localhost:5432/db}" \
  API_BASE_URL="${API_BASE_URL:-http://127.0.0.1:3001}" \
  NEXT_PUBLIC_API_BASE_URL="${NEXT_PUBLIC_API_BASE_URL:-http://127.0.0.1:3001}" \
  bun run test:web:e2e
}

for path in "${staged_files[@]}"; do
  case "$path" in
    apps/web/*)
      changed_web=1
      rel="${path#apps/web/}"

      case "$rel" in
        *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs)
          web_lint_files+=("$rel")
          ;;
      esac
      ;;
    apps/api/*)
      changed_api=1
      ;;
    packages/ai/*)
      changed_ai=1
      ;;
    packages/db/*)
      changed_db=1
      ;;
    packages/logger/*)
      changed_logger=1
      ;;
    apps/ios/*)
      changed_ios=1
      ;;
  esac
done

echo "pre-commit: branch '$current_branch'"

case "$current_branch" in
  main)
    echo "pre-commit: running full test suite for main"
    bun run test
    run_ios_tests 1 0
    run_web_e2e_tests
    ;;
  develop)
    echo "pre-commit: running unit tests only for develop"
    bun run test
    run_ios_tests 0 0
    ;;
  *)
    echo "pre-commit: running changed-workspace lint + unit tests"

    if [ "${#web_lint_files[@]}" -gt 0 ]; then
      echo "pre-commit: linting changed files in apps/web"
      (
        cd apps/web
        bun run lint -- "${web_lint_files[@]}"
      )
    fi

    if [ "$changed_api" -eq 1 ]; then
      echo "pre-commit: linting apps/api"
      bun run --filter=./apps/api lint
    fi

    if [ "$changed_ai" -eq 1 ]; then
      echo "pre-commit: linting packages/ai"
      bun run --filter=./packages/ai lint
    fi

    if [ "$changed_db" -eq 1 ]; then
      echo "pre-commit: linting packages/db"
      bun run --filter=./packages/db lint
    fi

    if [ "$changed_logger" -eq 1 ]; then
      echo "pre-commit: linting packages/logger"
      bun run --filter=./packages/logger lint
    fi

    if [ "$changed_web" -eq 1 ]; then
      echo "pre-commit: running unit tests in apps/web"
      bun run --filter=./apps/web test
    fi

    if [ "$changed_api" -eq 1 ]; then
      echo "pre-commit: running unit tests in apps/api"
      bun run --filter=./apps/api test
    fi

    if [ "$changed_ai" -eq 1 ]; then
      echo "pre-commit: running unit tests in packages/ai"
      bun run --filter=./packages/ai test
    fi

    if [ "$changed_db" -eq 1 ]; then
      echo "pre-commit: running unit tests in packages/db"
      bun run --filter=./packages/db test
    fi

    if [ "$changed_logger" -eq 1 ]; then
      echo "pre-commit: running unit tests in packages/logger"
      bun run --filter=./packages/logger test
    fi

    if [ "$changed_ios" -eq 1 ]; then
      run_ios_tests 0 1
    fi
    ;;
esac
