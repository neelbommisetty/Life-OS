{
  "schemaVersion": 3,
  "title": "Life-OS design system",
  "source": "apps/web/src/tokens.css",
  "register": "product",
  "colorStrategy": "restrained",
  "theme": "light",
  "palette": "ocean-blue",
  "paletteStatus": "final",
  "paletteConfirmedOn": "2026-09-25",
  "paletteScope": "All Life-OS web slices",
  "tokens": {
    "ocean-50": "oklch(0.965 0.018 245)",
    "ocean-100": "oklch(0.91 0.04 245)",
    "ocean-200": "oklch(0.86 0.055 245)",
    "ocean-300": "oklch(0.75 0.07 245)",
    "ocean-600": "oklch(0.49 0.11 245)",
    "ocean-700": "oklch(0.43 0.1 245)",
    "neutral-0": "oklch(0.995 0.002 245)",
    "neutral-50": "oklch(0.985 0.003 245)",
    "neutral-100": "oklch(0.975 0.006 245)",
    "neutral-200": "oklch(0.89 0.009 245)",
    "neutral-500": "oklch(0.56 0.012 245)",
    "neutral-600": "oklch(0.47 0.012 245)",
    "neutral-900": "oklch(0.35 0.016 245)",
    "canvas": "var(--neutral-0)",
    "sidebar": "var(--neutral-100)",
    "surface": "var(--neutral-50)",
    "surface-hover": "var(--ocean-50)",
    "ink": "var(--neutral-900)",
    "muted": "var(--neutral-600)",
    "border": "var(--neutral-200)",
    "control-border": "var(--neutral-500)",
    "accent": "var(--ocean-600)",
    "accent-hover": "var(--ocean-700)",
    "accent-soft": "var(--ocean-50)",
    "on-accent": "var(--neutral-0)",
    "action-fill": "var(--ocean-100)",
    "action-hover": "var(--ocean-200)",
    "action-ink": "var(--ocean-700)",
    "action-border": "var(--ocean-300)",
    "danger": "oklch(0.48 0.13 28)",
    "danger-hover": "oklch(0.4 0.12 28)",
    "danger-soft": "oklch(0.97 0.012 28)",
    "warning": "oklch(0.48 0.09 72)",
    "warning-soft": "oklch(0.97 0.018 72)",
    "info": "var(--ocean-600)",
    "info-soft": "var(--ocean-50)",
    "success": "var(--accent)",
    "success-soft": "var(--accent-soft)",
    "disabled-ink": "var(--neutral-600)",
    "disabled-surface": "var(--neutral-100)",
    "scrim": "oklch(0.25 0.016 245 / 0.35)",
    "shadow-menu": "0 8px 28px oklch(0.25 0.016 245 / 0.12)",
    "shadow-dialog": "0 24px 80px oklch(0.25 0.016 245 / 0.2)",
    "shadow-toast": "0 6px 24px oklch(0.25 0.016 245 / 0.16)",
    "font-body": "\"DM Sans Variable\", sans-serif",
    "font-heading": "\"Manrope Variable\", sans-serif",
    "text-xs": "0.75rem",
    "text-sm": "0.875rem",
    "text-base": "1rem",
    "text-lg": "1.25rem",
    "text-xl": "1.5rem",
    "text-page": "2rem",
    "leading-body": "1.5",
    "leading-heading": "1.25",
    "space-1": "0.25rem",
    "space-2": "0.5rem",
    "space-3": "0.75rem",
    "space-4": "1rem",
    "space-5": "1.25rem",
    "space-6": "1.5rem",
    "space-8": "2rem",
    "space-10": "2.5rem",
    "space-12": "3rem",
    "space-16": "4rem",
    "radius-sm": "0.25rem",
    "radius-control": "0.5rem",
    "radius-panel": "0.75rem",
    "radius-dialog": "1rem",
    "radius-round": "50%",
    "control-size": "2.75rem",
    "sidebar-width": "16rem",
    "topbar-height": "4rem",
    "content-width": "58rem",
    "board-width": "88rem",
    "duration-fast": "150ms",
    "duration-normal": "200ms",
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "layer-sidebar": "30",
    "layer-scrim": "29",
    "layer-overlay": "60",
    "layer-dialog": "61",
    "layer-menu": "70",
    "layer-toast": "80",
    "layer-skip": "100"
  },
  "breakpoints": {
    "mobile": "680px",
    "compactSidebar": "900px",
    "compactContent": "1100px"
  },
  "components": {
    "Button": {
      "source": "apps/web/src/ui.tsx",
      "variants": [
        "primary",
        "secondary",
        "destructive"
      ],
      "states": [
        "default",
        "hover",
        "focus",
        "active",
        "disabled",
        "pending"
      ]
    },
    "IconButton": {
      "source": "apps/web/src/ui.tsx",
      "requiredProps": [
        "aria-label"
      ],
      "target": "44px"
    },
    "Badge": {
      "source": "apps/web/src/ui.tsx",
      "tones": [
        "neutral",
        "accent",
        "info"
      ],
      "interactive": false
    },
    "Modal": {
      "source": "apps/web/src/ui.tsx",
      "widths": [
        "28rem",
        "40rem"
      ],
      "primitive": "Radix Dialog",
      "returnFocus": "Trigger when available; mobile navigation toggle when trigger is in the closed drawer"
    },
    "Menu": {
      "source": "apps/web/src/ui.tsx",
      "primitive": "Radix Dropdown Menu"
    },
    "Shell": {
      "source": "apps/web/src/Shell.tsx",
      "slots": [
        "sidebar",
        "children"
      ],
      "props": [
        "title",
        "description"
      ],
      "navigation": [
        "/todo",
        "/calendar"
      ],
      "mobileFocusTargets": [
        "links",
        "buttons",
        "inputs",
        "selects",
        "textareas"
      ]
    }
  }
}
