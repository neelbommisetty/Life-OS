{
  "name": "@writers-block/ai-core",
  "version": "0.1.0",
  "description": "Core AI schema and tooling utilities for WritersBlock",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "workspace:prisma": "node -e \"\"",
    "build": "rollup -c",
    "dev": "rollup -cw",
    "lint": "eslint \"src/**/*.{ts}\" --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@writers-block/logger": "workspace:*",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.6"
  }
}
