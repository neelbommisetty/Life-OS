{
  "name": "@writers-block/ai-providers",
  "version": "0.1.0",
  "description": "Provider adapters for integrating third-party LLM clients with WritersBlock",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "workspace:prisma": "node -e \"\"",
    "build": "rollup -c",
    "dev": "rollup -cw",
    "lint": "eslint \"src/**/*.{ts}\" --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@google/generative-ai": "^0.20.0",
    "@writers-block/ai-core": "workspace:*",
    "@writers-block/logger": "workspace:*",
    "openai": "^6.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.3",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.24.2",
    "rollup-plugin-dts": "^6.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod-to-json-schema": "^3.24.6"
  }
}
