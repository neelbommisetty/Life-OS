    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
