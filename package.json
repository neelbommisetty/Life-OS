{
  "name": "project-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "dotenv -e .env.development.local -e .env.local -- prisma generate",
    "dev": "next dev",
    "prebuild": "dotenv -e .env.development.local -e .env.local -- prisma migrate deploy && dotenv -e .env.development.local -e .env.local -- prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate:dev": "dotenv -e .env.development.local -e .env.local -- prisma migrate dev",
    "migrate:deploy": "dotenv -e .env.development.local -e .env.local -- prisma migrate deploy",
    "migrate:reset": "dotenv -e .env.development.local -e .env.local -- prisma migrate reset",
    "migrate:status": "dotenv -e .env.development.local -e .env.local -- prisma migrate status",
    "db:push": "dotenv -e .env.development.local -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.development.local -e .env.local -- prisma studio",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
