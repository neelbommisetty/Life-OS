{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun --filter=./apps/web dev",
    "build": "bun --filter=./apps/web build",
    "start": "bun --filter=./apps/web start",
    "lint": "bun --filter=./apps/web lint",
    "prisma:generate": "bun --filter=./apps/web prisma:generate",
    "prisma:migrate": "bun --filter=./apps/web prisma:migrate",
    "prisma:deploy": "bun --filter=./apps/web prisma:deploy"
  }
}
