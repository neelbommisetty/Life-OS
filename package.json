{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter=./apps/web --filter=./apps/api dev",
    "dev:all": "bun run --filter=./apps/web --filter=./apps/api dev",
    "dev:web": "bun --filter=./apps/web dev",
    "dev:api": "bun --filter=./apps/api dev",
    "prepare:runtime": "bun run prisma:generate && bun --filter=./packages/ai run build",
    "postinstall": "bun run prepare:runtime",
    "prebuild": "bun run prepare:runtime",
    "build": "bun run --filter=./apps/web build",
    "vercel:install:api": "bun install --frozen-lockfile",
    "vercel:install:web": "bun install --frozen-lockfile",
    "start": "bun --filter=./apps/web start",
    "lint": "bun run --filter=./apps/web --filter=./apps/api --filter=./packages/ai --filter=./packages/db --filter=./packages/logger lint",
    "test": "bun run --filter=./apps/web --filter=./apps/api --filter=./packages/ai --filter=./packages/db --filter=./packages/logger test",
    "test:web": "bun --filter=./apps/web test",
    "test:web:e2e": "bun --filter=./apps/web test:e2e",
    "test:web:e2e:headed": "bun --filter=./apps/web test:e2e:headed",
    "test:api": "bun --filter=./apps/api test",
    "prisma:generate": "bun --filter=./packages/db prisma:generate",
    "prisma:migrate": "bun --filter=./packages/db prisma:migrate",
    "prisma:deploy": "bun --filter=./packages/db prisma:deploy",
    "lint:web": "bun --filter=./apps/web lint",
    "commit:setup": "bash ./scripts/setup-git-hooks.sh",
    "commit:lint:last": "commitlint --from=HEAD~1 --to=HEAD"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/bun": "^1.3.8"
  }
}
