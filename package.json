{
  "name": "life-os",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --cwd packages/tools typecheck && bun run --cwd apps/web typecheck",
    "test": "bun run --cwd packages/tools test && bun run --cwd apps/web test",
    "life": "node packages/tools/bin/life.js",
    "api": "node packages/tools/src/api/server.ts",
    "web": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "web:start": "bun run --cwd apps/web start",
    "test:web": "bun run --cwd apps/web test"
  }
}
