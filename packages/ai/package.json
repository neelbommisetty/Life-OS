{
  "name": "@life-os/ai",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./services": {
      "types": "./src/services.ts",
      "import": "./dist/services.js",
      "default": "./dist/services.js"
    },
    "./init": {
      "types": "./src/init.ts",
      "import": "./dist/init.js",
      "default": "./dist/init.js"
    },
    "./providers": {
      "types": "./src/providers/index.ts",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./providers/registry": {
      "types": "./src/providers/registry.ts",
      "import": "./dist/providers/registry.js",
      "default": "./dist/providers/registry.js"
    },
    "./tracking": {
      "types": "./src/tracking/index.ts",
      "import": "./dist/tracking/index.js",
      "default": "./dist/tracking/index.js"
    }
  },
  "scripts": {
    "build:clean": "rm -rf dist",
    "build:core": "bun build src/index.ts --target=node --format=esm --packages=external --outfile dist/index.js && bun build src/services.ts --target=node --format=esm --packages=external --outfile dist/services.js && bun build src/init.ts --target=node --format=esm --packages=external --outfile dist/init.js",
    "build:providers": "bun build src/providers/index.ts --target=node --format=esm --packages=external --outfile dist/providers/index.js && bun build src/providers/registry.ts --target=node --format=esm --packages=external --outfile dist/providers/registry.js",
    "build:tracking": "bun build src/tracking/index.ts --target=node --format=esm --packages=external --outfile dist/tracking/index.js",
    "build": "bun run build:clean && bun run build:core && bun run build:providers && bun run build:tracking",
    "test": "bun test",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/generative-ai": "^0.24.1",
    "@life-os/db": "workspace:*",
    "@life-os/logger": "workspace:*",
    "@prisma/client": "^7.3.0",
    "openai": "^6.17.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
