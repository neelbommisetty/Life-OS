{
  "name": "@life-os/ai",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./services": {
      "types": "./src/services.ts",
      "import": "./dist/services.js",
      "default": "./dist/services.js"
    },
    "./init": "./src/init.ts",
    "./providers": "./src/providers/index.ts",
    "./providers/*": "./src/providers/*.ts",
    "./tracking": "./src/tracking/index.ts",
    "./tracking/*": "./src/tracking/*.ts"
  },
  "scripts": {
    "build": "bun build src/services.ts --target=node --format=esm --outdir dist",
    "test": "bun test",
    "lint": "tsc --noEmit -p tsconfig.lint.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/generative-ai": "^0.24.1",
    "@life-os/db": "workspace:*",
    "@life-os/logger": "workspace:*",
    "@prisma/client": "^7.3.0",
    "openai": "^6.17.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
