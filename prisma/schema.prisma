generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  IDEA
  IN_PROGRESS
  MVP
  COMPLETE
  ARCHIVE
  DEFER
  NOT_INTERESTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum ChatRole {
  SYSTEM
  USER
  ASSISTANT
}

enum ArtifactType {
  TEXT
  LINK
  FILE
}

model Project {
  id            String          @id @default(cuid())
  name          String
  description   String?
  status        ProjectStatus   @default(IDEA)
  priority      Priority?       @default(MEDIUM)
  tags          String[]
  color         String?
  icon          String?
  dueDate       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  statusHistory StatusHistory[]
  tasks         Task[]
  chatThreads   ChatThread[]
  artifacts     Artifact[]
}

model StatusHistory {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    ProjectStatus
  timestamp DateTime      @default(now())
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(BACKLOG)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId, status, sortOrder])
}

model ChatThread {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String        @default("New thread")
  modelKey    String?
  summary     String?
  summaryUpTo DateTime?
  lastChattedAt DateTime    @default(now())
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([projectId, archivedAt, lastChattedAt])
}

model ChatMessage {
  id             String     @id @default(cuid())
  threadId       String
  thread         ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  modelKey       String?
  modelLabel     String?
  modelProvider  String?
  taskResolution Json?
  createdAt      DateTime   @default(now())

  @@index([threadId, createdAt])
}

model Artifact {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      ArtifactType
  title     String
  content   String?
  url       String?
  fileKey   String?
  fileName  String?
  fileSize  Int?
  fileType  String?
  fileUrl   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([projectId, createdAt])
}
