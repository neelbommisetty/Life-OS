// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ChatRole {
  SYSTEM
  USER
  ASSISTANT
}

enum AiCallType {
  CHAT_STREAM
  CHAT_BLOCKING
  SUMMARY_CALL
  TITLE_GEN_CALL
}

enum AiCallStatus {
  SUCCESS
  ERROR
  ABORTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model ChatThread {
  id            String        @id @default(cuid())
  userId        String        // From Neon Auth
  name          String        @default("New thread")
  modelKey      String?
  summary       String?
  summaryUpTo   DateTime?
  lastChattedAt DateTime      @default(now())
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]
  aiCalls       AiCall[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, archivedAt, lastChattedAt])
}

model ChatMessage {
  id               String     @id @default(cuid())
  threadId         String
  thread           ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role             ChatRole
  content          String
  modelKey         String?
  modelLabel       String?
  modelProvider    String?
  tokenCount       Int?
  tokenCountSource String?
  createdAt        DateTime   @default(now())

  @@index([threadId, createdAt])
}

model AiCall {
  id                       String       @id @default(cuid())
  userId                   String

  // Optional relations for attribution
  threadId                 String?
  thread                   ChatThread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)
  messageId                String?      // Links to the ChatMessage this call produced

  // Call classification
  callType                 AiCallType

  // Model identification
  providerId               String
  modelKey                 String?
  modelId                  String?

  // Token metrics
  inputTokens              Int?
  outputTokens             Int?
  totalTokens              Int?
  cacheCreationInputTokens Int?
  cacheReadInputTokens     Int?
  totalStreamedTokens      Int?

  // Streaming timing (full metrics)
  streamingStartAt         DateTime?
  streamingEndAt           DateTime?
  streamingTps             Float?       // Tokens per second

  // Request timing
  requestStartAt           DateTime
  firstTokenAt             DateTime?
  responseEndAt            DateTime?
  totalLatencyMs           Int?

  // Cost tracking
  costUsd                  Decimal      @db.Decimal(12, 6)
  cacheCreationCostUsd     Decimal?     @db.Decimal(12, 6)
  cacheReadCostUsd         Decimal?     @db.Decimal(12, 6)
  priceSnapshot            Json         // Snapshot of pricing at call time

  // Status and metadata
  status                   AiCallStatus
  attempts                 Json?        // Array of all model attempts for failover

  createdAt                DateTime     @default(now())

  @@index([userId, requestStartAt])
  @@index([threadId, requestStartAt])
  @@index([providerId, modelId])
  @@index([callType])
}

model Task {
  id          String     @id @default(cuid())
  userId      String     // From Neon Auth
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, deletedAt])
}
