generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  IDEA
  IN_PROGRESS
  MVP
  COMPLETE
  ARCHIVE
  DEFER
  NOT_INTERESTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum ChatRole {
  SYSTEM
  USER
  ASSISTANT
}

enum ArtifactType {
  TEXT
  LINK
  FILE
}

enum AiCallStatus {
  SUCCESS
  ERROR
  ABORTED
}

model Project {
  id            String          @id @default(cuid())
  name          String
  description   String?
  status        ProjectStatus   @default(IDEA)
  priority      Priority?       @default(MEDIUM)
  tags          String[]
  color         String?
  icon          String?
  dueDate       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  statusHistory StatusHistory[]
  tasks         Task[]
  chatThreads   ChatThread[]
  artifacts     Artifact[]
  aiCalls       AiCall[]
}

model StatusHistory {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    ProjectStatus
  timestamp DateTime      @default(now())
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(BACKLOG)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId, status, sortOrder])
}

model ChatThread {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String        @default("New thread")
  modelKey    String?
  summary     String?
  summaryUpTo DateTime?
  reasoningEnabled Boolean @default(false)
  lastChattedAt DateTime    @default(now())
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]
  aiCalls     AiCall[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([projectId, archivedAt, lastChattedAt])
}

model ChatMessage {
  id             String     @id @default(cuid())
  threadId       String
  thread         ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  modelKey       String?
  modelLabel     String?
  modelProvider  String?
  tokenCount     Int?
  tokenCountSource String?
  taskResolution Json?
  createdAt      DateTime   @default(now())

  @@index([threadId, createdAt])
}

model ChatMessageReasoning {
  id               String     @id @default(cuid())
  messageId        String     @unique
  message          ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  content          String
  tokenCount       Int?
  tokenCountSource String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Artifact {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      ArtifactType
  title     String
  content   String?
  url       String?
  fileKey   String?
  fileName  String?
  fileSize  Int?
  fileType  String?
  fileUrl   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([projectId, createdAt])
}

model AiCall {
  id                 String       @id @default(cuid())
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  threadId           String?
  thread             ChatThread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)
  userId             String?
  source             String
  actionType         String
  providerId         String
  modelKey           String?
  modelId            String?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  cacheCreationInputTokens Int?
  cacheReadInputTokens Int?
  totalStreamedTokens Int?
  streamingStartAt   DateTime?
  streamingEndAt     DateTime?
  streamingTps       Float?
  requestStartAt     DateTime
  firstTokenAt       DateTime?
  responseEndAt      DateTime?
  queueMs            Int?
  modelMs            Int?
  totalLatencyMs     Int?
  cacheCreationInputCostUsd Decimal? @db.Decimal(12, 6)
  cacheReadInputCostUsd Decimal? @db.Decimal(12, 6)
  costUsd            Decimal      @db.Decimal(12, 6)
  priceSnapshot      Json
  status             AiCallStatus
  artifactRef        String?
  metadataTags       String[]     @default([])
  attempts           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([projectId, requestStartAt])
  @@index([threadId, requestStartAt])
  @@index([userId, requestStartAt])
  @@index([providerId, modelId])
  @@index([source, actionType])
}
